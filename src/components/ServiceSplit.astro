---
import { cta } from '../data/site';

const services = [
  {
    title: 'On-Location Content',
    copy: 'Content produced where your brand comes to life, from hotels and destinations to restaurants, experiences, events, and live activations.',
    categories: 'Hospitality · Travel · Experiences · Events',
    ctaLabel: cta.onLocationPricing,
    href: '#onlocation-pricing',
    icon: 'location',
  },
  {
    title: 'UGC + Product Content',
    copy: 'Short-form content created around your product, service, or platform for organic social, campaigns, and paid media.',
    categories: 'Products · Apps · Tech · Wellness · Lifestyle',
    ctaLabel: cta.ugcPricing,
    href: '#ugc-pricing',
    icon: 'device',
  },
];
---
<section id="services" class="sec">
  <div class="wrap">
    <p class="eyebrow rv">Content Production</p>
    <h2 class="h2 rv">Two ways to build your <i>campaign.</i></h2>
    <p class="lede rv">Choose the production style that fits your project.</p>
    <div class="duo">
      {services.map((s) => (
        <article class="card rv">
          <div class="card-ic">
            {s.icon === 'location' ? (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" />
              </svg>
            ) : (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="7" y="2" width="10" height="20" rx="2" /><line x1="11" y1="18" x2="13" y2="18" />
              </svg>
            )}
          </div>
          <h3 class="card-t">{s.title}</h3>
          <p class="card-c">{s.copy}</p>
          <p class="card-cat">{s.categories}</p>
          <a class="txtlink" href={s.href}>{s.ctaLabel} &rarr;</a>
        </article>
      ))}
    </div>
  </div>
</section>
