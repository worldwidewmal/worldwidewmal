---
import { productionAddOns, licensingAddOns, usageNote, type AddOnGroup } from '../data/brand-pricing';

/**
 * Add-ons and licensing, as full-width accordion rows.
 *
 * Everything here is deliberately closed by default. These are commercial
 * terms, not services — showing every rate at once buries the core packages
 * above and makes the business look like six businesses. Drone and
 * photography live inside Production Add-Ons for the same reason: they are
 * things you add to a shoot, not a category of their own.
 */
const groups: AddOnGroup[] = [productionAddOns, ...licensingAddOns];
---

<section id="addons" class="sec alt">
  <div class="wrap">
    <p class="eyebrow rv">Expand Your Production</p>
    <h2 class="h2 rv">Add-ons, usage, and <i>licensing.</i></h2>
    <p class="lede rv">{usageNote}</p>

    <div class="acc rv">
      {groups.map((g) => (
        <div class="acc-item" id={`addon-${g.id}`}>
          <h3 class="acc-h">
            <button
              type="button"
              class="acc-btn js-acc"
              aria-expanded="false"
              aria-controls={`addon-panel-${g.id}`}
            >
              <span class="acc-title">
                <span class="acc-name">{g.title}</span>
                {g.scope && <span class="acc-scope">{g.scope}</span>}
              </span>
              <span class="acc-ic" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="acc-panel" id={`addon-panel-${g.id}`} role="region" hidden>
            <ul class="acc-rows">
              {g.rows.map((r) => (
                <li class="acc-row">
                  <span class="acc-row-l">
                    {r.label}
                    {r.note && <span class="acc-row-n">{r.note}</span>}
                  </span>
                  <span class={r.price ? 'acc-row-p' : 'acc-row-p acc-row-p-tbc'}>
                    {r.price ?? 'Rate on request'}
                  </span>
                </li>
              ))}
            </ul>
            {g.footnote && <p class="acc-foot">{g.footnote}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    /* One delegated handler for every accordion. Each control is a real
       <button>, so keyboard and touch work without extra key handling.
       `hidden` is toggled alongside the class so collapsed content is removed
       from the accessibility tree and from find-in-page, not just visually
       clipped. */
    var acc = document.querySelector('.acc');
    if (!acc) return;

    acc.addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('.js-acc') : null;
      if (!btn) return;

      var panel = document.getElementById(btn.getAttribute('aria-controls'));
      if (!panel) return;

      var open = btn.getAttribute('aria-expanded') === 'true';

      if (open) {
        btn.setAttribute('aria-expanded', 'false');
        panel.hidden = true;
        btn.parentElement.parentElement.classList.remove('open');
        return;
      }

      /* Only one open at a time — keeps the section short enough to scan and
         stops the page from growing by several screens on a phone. */
      acc.querySelectorAll('.js-acc[aria-expanded="true"]').forEach(function (other) {
        other.setAttribute('aria-expanded', 'false');
        other.parentElement.parentElement.classList.remove('open');
        var otherPanel = document.getElementById(other.getAttribute('aria-controls'));
        if (otherPanel) otherPanel.hidden = true;
      });

      btn.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      btn.parentElement.parentElement.classList.add('open');
    });
  })();
</script>
