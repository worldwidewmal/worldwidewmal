---
import { cta } from '../data/site';
import { serviceOptions, budgetOptions } from '../data/brand-pricing';

/* Web3Forms public access key. Public by design — it only routes the form to
   the owner's inbox and carries no account privileges. */
const ACCESS_KEY = '43898b71-02c7-419d-8c4b-6ee3b1ca6121';
---

<section id="start" class="sec">
  <div class="wrap center">
    <p class="eyebrow center rv">Start a Project</p>
    <h2 class="h2 rv">Tell me what you're <i>building.</i></h2>
    <p class="lede rv">
      Share the basics below and I'll recommend the best production option for your project.
    </p>
  </div>
  <div class="wrap">
    <div class="formwrap">
      <section class="psumm rv" id="project-summary" aria-labelledby="psumm-title" hidden>
        <div class="psumm-head">
          <h3 class="psumm-t" id="psumm-title">Your Project</h3>
          <button type="button" class="txtlink psumm-edit" id="psumm-edit">Edit Project</button>
        </div>
        <div id="psumm-body"></div>
      </section>

      <form
        id="project-form"
        class="rv"
        action="https://api.web3forms.com/submit"
        method="POST"
        style="text-align:left"
      >
        <input type="hidden" name="access_key" value={ACCESS_KEY} />
        <input type="hidden" name="subject" value="New Project Inquiry" />
        <input type="hidden" name="project" id="pf-project" value="" />
        {/* Honeypot — hidden from people, tempting to bots. */}
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

        <div class="frow">
          <div class="field">
            <label class="flabel" for="pf-name">Name</label>
            <input class="finput" id="pf-name" name="name" type="text" maxlength="100" autocomplete="name" placeholder="Your name" required />
          </div>
          <div class="field">
            <label class="flabel" for="pf-email">Work Email</label>
            <input class="finput" id="pf-email" name="email" type="email" maxlength="254" autocomplete="email" placeholder="you@company.com" required />
          </div>
        </div>

        <div class="frow">
          <div class="field">
            <label class="flabel" for="pf-company">Company / Brand</label>
            <input class="finput" id="pf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="Brand name" required />
          </div>
          <div class="field">
            <label class="flabel" for="pf-website">Website / Social <span>(optional)</span></label>
            <input class="finput" id="pf-website" name="website" type="text" maxlength="120" autocomplete="url" placeholder="Website or @handle" />
          </div>
        </div>

        <div class="frow">
          <div class="field" id="field-service">
            <label class="flabel" for="pf-service">Service Needed</label>
            <select class="fselect" id="pf-service" name="service" required>
              <option value="" disabled selected>Select a service</option>
              {serviceOptions.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div class="field">
            <label class="flabel" for="pf-budget">Budget Range</label>
            <select class="fselect" id="pf-budget" name="budget">
              <option value="" disabled selected>Select a range</option>
              {budgetOptions.map((o) => <option>{o}</option>)}
            </select>
          </div>
        </div>

        <div class="field">
          <label class="flabel" for="pf-timeline">Timeline</label>
          <input class="finput" id="pf-timeline" name="timeline" type="text" maxlength="120" autocomplete="off" placeholder="When do you need the content?" />
        </div>

        <div class="field">
          <label class="flabel" for="pf-details">Project Details</label>
          <textarea
            class="ftext"
            id="pf-details"
            name="message"
            maxlength="2000"
            placeholder="Tell me about the brand, campaign, deliverables, location, and what you're looking to create."
          ></textarea>
        </div>

        <button type="submit" class="btn btn-g fsubmit" id="pf-submit">{cta.getQuote}</button>
      </form>

      <div class="fsuccess" id="project-success" role="status" aria-live="polite">
        <div class="fsuccess-t">Project received.</div>
        <p class="fsuccess-c">
          I'll review the details and reach out with the best next step for your campaign.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var form = document.getElementById('project-form');
    if (!form) return;

    /* ── project builder bridge ──────────────────────────────────────────
       Whatever the visitor selected while scrolling is shown here in full,
       so arriving at the form confirms their choices rather than hiding
       them. The same content also rides along as readable text for the
       inquiry email. */
    var P = window.WW_PROJECT;
    var summary = document.getElementById('project-summary');
    var summaryBody = document.getElementById('psumm-body');
    var serviceField = document.getElementById('field-service');
    var serviceInput = document.getElementById('pf-service');
    var projectInput = document.getElementById('pf-project');

    function esc(v) {
      return String(v).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function syncProject() {
      if (!P || !summary) return;
      var s = P.summary();

      if (!s.count) {
        summary.hidden = true;
        if (serviceField) serviceField.hidden = false;
        if (serviceInput) serviceInput.required = true;
        if (projectInput) projectInput.value = '';
        return;
      }

      var html = '';
      s.groups.forEach(function (g) {
        html += '<div class="pgroup"><div class="pgroup-t">' + esc(g.title) + '</div><ul class="plist">';
        g.items.forEach(function (i) {
          html += '<li><span class="pl-l">' + esc(i.label) + '</span>' +
                  '<span class="pl-p' + (i.custom ? ' pl-custom' : '') + '">' + esc(i.price) + '</span></li>';
        });
        html += '</ul></div>';
      });
      html += '<div class="ptotal"><span>Estimated Total</span><span class="ptotal-v">';
      if (s.totalLabel) {
        html += esc(s.totalLabel);
        if (s.custom.length) html += ' <span class="ptotal-plus">+ custom add-ons</span>';
      } else {
        html += '<span class="ptotal-plus">Quoted based on scope</span>';
      }
      html += '</span></div>';
      summaryBody.innerHTML = html;
      summary.hidden = false;

      /* The service is implied by the chosen package, and it is stated in the
         summary directly above — asking for it again is pure friction. */
      var hasPackage = s.groups.some(function (g) { return g.title === 'Core package'; });
      if (serviceField && hasPackage) {
        serviceField.hidden = true;
        if (serviceInput) serviceInput.required = false;
      } else if (serviceField) {
        serviceField.hidden = false;
        if (serviceInput) serviceInput.required = true;
      }

      if (projectInput) projectInput.value = P.asText();
    }

    if (P) P.onChange(syncProject);

    var edit = document.getElementById('psumm-edit');
    if (edit) {
      edit.addEventListener('click', function () {
        var open = document.getElementById('pbar-open');
        if (open) open.click();
      });
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var sec = window.WW_SECURITY;
      var btn = document.getElementById('pf-submit');
      if (!sec) { alert('Please refresh the page and try again.'); return; }
      if (!sec.acquire('project-form', 60000)) return;

      var data = sec.safeForm(form, {
        name: 100, email: 254, company: 120, website: 120,
        service: 80, budget: 60, timeline: 120,
        /* Both of these are read by a person, so their line breaks matter. */
        message: { max: 2000, multiline: true },
        project: { max: 4000, multiline: true }
      });

      if (!sec.validEmail(data.email)) {
        sec.release('project-form');
        alert('Please enter a valid email address.');
        return;
      }

      var original = btn ? btn.textContent : '';
      if (btn) { btn.textContent = 'Sending...'; btn.disabled = true; }

      sec.postJSON('https://api.web3forms.com/submit', {
        access_key: form.querySelector('[name="access_key"]').value,
        subject: 'New Project Inquiry: ' + (data.company || data.name || 'Brand'),
        botcheck: data.botcheck || '',
        from_name: data.name,
        email: data.email,
        company: data.company,
        website: data.website || '-',
        service: data.service || '(selected in project builder)',
        project: data.project || '(no selections made)',
        budget: data.budget || '-',
        timeline: data.timeline || '-',
        message: data.message || '-'
      }).then(function () {
        form.style.display = 'none';
        document.getElementById('project-success').classList.add('show');
        /* Counted only once the provider accepted it, so this measures real
           inquiries rather than clicks on the button. */
        document.dispatchEvent(new CustomEvent('ww:form-submitted', {
          detail: { has_project: !!(projectInput && projectInput.value) }
        }));
      }).catch(function () {
        if (btn) { btn.textContent = original || 'Get My Project Quote'; btn.disabled = false; }
        alert('Error sending. Email partnerships@worldwidewmal.com directly.');
      }).then(function () {
        sec.release('project-form');
      });
    });
  })();
</script>
